# Storage settings
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_BYTES=52428800

# Profiler settings
SAMPLE_VALUES_COUNT=5
TOP_CATEGORICAL_LIMIT=5

# LLM settings
# LLM_PROVIDER options: "mock" (no key needed), "gemini"
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_API_KEY=
LLM_TEMPERATURE=0.0
MAX_PLAN_RETRIES=2
